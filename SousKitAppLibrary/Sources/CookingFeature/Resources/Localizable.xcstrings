{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ custom timer" : {
      "comment" : "The title a custom timer goes off under. The system cuts a long title off at its end, so the length comes first.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ custom timer"
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (aangepast)"
          }
        }
      }
    },
    "%@ for step %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ for step %2$lld"
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ voor stap %2$lld"
          }
        }
      }
    },
    "Allow timers" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow timers"
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timers toestaan"
          }
        }
      }
    },
    "Allow timers in Settings, so a timer keeps running and goes off, even with the app closed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow timers in Settings, so a timer keeps running and goes off, even with the app closed."
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta timers toe in Instellingen, zodat een timer blijft lopen en afgaat, ook als de app gesloten is."
          }
        }
      }
    },
    "Are you sure you want to stop cooking?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to stop cooking?"
